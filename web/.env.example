# 비워 두면 GitHub 공개 데이터(data/cafes.json)를 읽고, 회원 기능(가입·로그인·북마크·리뷰)은 꺼진다.
# 넣을 키는 anon(public) 키만 (Streamlit 의 SUPABASE_KEY 와 같은 값). service_role 키는 절대 넣지 않는다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 (서버에서만 쓰는 값).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- 로그인 (Streamlit 앱과 같은 값을 넣어야 같은 계정·같은 회원 번호가 된다) ----
# 로그인 쿠키 서명 비밀값 (16자 이상). Streamlit 의 AUTH_SECRET 과 같게.
AUTH_SECRET=
# 회원 번호(해시)에 넣는 소금. Streamlit 에 넣었다면 같은 값, 안 넣었다면 비워 둔다 (기본값이 같다).
REVIEW_NICK_SALT=
# 이 사이트 주소. 간편 로그인 Redirect URI = {SITE_URL}/auth (카카오·네이버 개발자 콘솔에 등록). 비우면 https://ani-where.vercel.app
SITE_URL=
# 카카오 로그인: 내 애플리케이션 > 앱 키 > REST API 키 / 보안 > Client Secret (켰을 때만)
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
# 네이버 로그인: 개발자센터 > 애플리케이션 > Client ID / Client Secret (둘 다 있어야 켜진다)
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# 관리자 회원 번호 (쉼표로 구분). 비우면 앱과 같은 기본 관리자 한 명. 관리자는 웹 /data 대시보드를 본다.
ADMIN_MEMBER_KEYS=
# ---- 관리자 대시보드 (/data) — Streamlit 과 같은 이름 · 같은 값 ----
# 사용자 테스트 응답 구글 시트 번호 (주소의 /d/ 와 /edit 사이). 시트는 '링크가 있는 모든 사용자 · 보기' 로 공유. 비우면 연결 안내만 보인다.
SURVEY_SHEET_ID=
# n8n 워크플로 바로가기 주소 (비우면 http://localhost:5678)
N8N_URL=
# 'Claude 예약 작업' 바로가기 주소 (비우면 https://claude.ai/code/routines)
ADMIN_ROUTINE_URL=

# ---- 시험용 (배포에 넣지 않는다) ----
# WEB_STORAGE=local 이면 회원 데이터를 실제 DB 대신 WEB_DATA_DIR 의 JSON 파일에 쌓는다.
# WEB_OAUTH_MOCK=1 은 local 일 때만 가짜 카카오·네이버 로그인(/auth/mock)을 켠다.
# WEB_STORAGE=
# WEB_DATA_DIR=
# WEB_OAUTH_MOCK=
# SURVEY_CSV_FILE 은 local 일 때만, 구글 시트 대신 읽을 설문 CSV 파일 (관리자 '사용자 테스트' 화면 점검용).
# SURVEY_CSV_FILE=

# 카카오 지도 JavaScript 키 (선택). 브라우저에 그대로 보이는 '공개용' 키라 NEXT_PUBLIC_ 을 붙이는 유일한 값이다.
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키. 플랫폼 > Web 에 사이트 도메인을 등록해야 지도가 뜬다.
# 비워 두면 /map 은 OpenStreetMap(Leaflet) 지도로 대신 보인다. REST API 키·Admin 키는 넣지 않는다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ---- 블로그 후기 (상세 '블로그 후기' 탭, 네이버 블로그 검색 · NAVER API HUB). 서버에서만 쓴다. Streamlit 과 같은 값.
# 네이버클라우드 콘솔 > NAVER API HUB > 블로그 검색 의 Client ID / Client Secret. 비우면 탭에 '네이버 검색을 연결한 뒤에 보여요'.
NAVER_BLOG_CLIENT_ID=
NAVER_BLOG_CLIENT_SECRET=
# (선택) 호출 주소. 비우면 https://naverapihub.apigw.ntruss.com/search/v1/blog
NAVER_BLOG_URL=
# (선택) 헤더 방식: ncp(기본, X-NCP-APIGW-API-KEY-ID/-KEY) 또는 naver(X-Naver-Client-Id/-Secret)
NAVER_BLOG_HEADERS=

# ---- 물어보기 AI (/ask 화면). 비우면 규칙 기반 대체로만 답한다. 서버에서만 쓴다 (NEXT_PUBLIC_ 금지).
# platform.openai.com > API keys. 질문은 개인정보를 가린 뒤에만 보낸다.
OPENAI_API_KEY=
# (선택) 모델 (비우면 gpt-4o-mini) · 호출 주소 (비우면 https://api.openai.com/v1)
OPENAI_MODEL=
OPENAI_BASE_URL=
# (선택) 프롬프트 버전: content/prompts/ask.<버전>.txt (원본 common/prompts). 비우면 가장 높은 버전
PROMPT_VERSION=
ASK_PROMPT_VERSION=
# (선택) 등록하기 · 공지 간편등록 프롬프트 버전 (common/prompts/cafe.<버전>.txt). 비우면 PROMPT_VERSION → 가장 높은 버전
CAFE_PROMPT_VERSION=

# ---- 등록하기 · 수정하기: 주소 → 지도 좌표 (서버에서만, NEXT_PUBLIC_ 금지). 비우면 지역 이름 표의 '대략 위치' 로 대신한다.
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키 (Streamlit 의 KAKAO_REST_API_KEY 와 같은 값)
KAKAO_REST_API_KEY=
# (선택) 카카오 키가 없을 때만: 네이버클라우드 Maps 지오코딩 Client ID / Secret, 네이버 검색 API(지역) Client ID / Secret
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ---- 팝업 목록 캐시 바로 비우기 (선택, 서버에서만). POST /api/revalidate 가 이 값으로 확인한다 (16자 이상 무작위 문자열).
# Streamlit Secrets · GitHub Actions Secret 의 WEB_REVALIDATE_SECRET 과 같은 값. 비우면 그 주소는 503 을 주고, 캐시는 10분마다 스스로 갱신된다
WEB_REVALIDATE_SECRET=
