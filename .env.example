# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Sheets (둘 중 하나만 채우면 됩니다)
# 1) 서비스 계정 JSON 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# 2) 시트 문서 키 (URL 의 /d/ 와 /edit 사이 문자열)
GSHEET_KEY=

# 카카오 (선택, 권장) — https://developers.kakao.com > 내 애플리케이션 > 앱 키
# REST API 키: 주소·가게 이름 검색과 좌표 변환
KAKAO_REST_API_KEY=
# JavaScript 키: 메인 지도. 플랫폼 > Web 에 http://localhost:8501 을 등록해야 지도가 뜹니다
KAKAO_JS_KEY=
# (우편번호 찾기는 키 없이 동작합니다)

# 네이버 주소 검색 (선택, 카카오 키가 없을 때만 씁니다. 둘 중 하나만 있어도 됩니다)
# 1) 네이버 클라우드 플랫폼 > Maps > Application 등록 후 Client ID / Secret (Geocoding 사용 체크)
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# 옛 콘솔에서 받은 키라면 https://naveropenapi.apigw.ntruss.com 로 바꿔 주세요
NAVER_MAPS_API_HOST=https://naveropenapi.apigw.gov-ntruss.com
# 2) 네이버 개발자센터 > 애플리케이션 등록 > 검색 API (가게 이름으로 찾기)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 저장소 모드: sheets | supabase | local  (local 이면 data/ 폴더의 JSON 파일을 씁니다)
# Streamlit Cloud 는 재배포 때 data/ 가 처음 상태로 돌아가므로, 배포본은 supabase 를 권장합니다 (db.md)
STORAGE_MODE=local

# Supabase (STORAGE_MODE=supabase 일 때). 대시보드 > Project Settings > API
# URL 예: https://abcd1234.supabase.co   키: anon(public) 키. service_role 키는 넣지 마세요 (RLS 를 건너뜁니다)
# Streamlit Cloud Secrets 에는 [섹션] 없이 맨 위 칸에 SUPABASE_URL = "..." 처럼 넣어야 환경변수로 보입니다
SUPABASE_URL=
SUPABASE_KEY=

# 프롬프트 버전 (앱별로 고정. 비워 두면 가장 높은 버전 파일을 씁니다)
PRIORITY_PROMPT_VERSION=v1
CAFE_PROMPT_VERSION=v2

# Notion 트래커 DB 자동 가져오기 (선택)
# https://www.notion.so/my-integrations 에서 '내부 통합' 을 만들고 키를 넣은 뒤,
# Notion 의 '🎀 애니 팝업·콜라보 트래커' DB 오른쪽 위 ··· > 연결 > 그 통합을 추가하세요
NOTION_TOKEN=
NOTION_DATABASE_ID=3da1fd80371141c697fabf7b742e0edc

# 간편 회원가입·로그인 (선택) — docs/login.md
# 앱 주소 (카카오·네이버에 등록하는 Redirect URI 는 이 주소 + /auth)
APP_BASE_URL=http://localhost:8501
# 로그인 쿠키 서명용 비밀값 (아무 긴 무작위 문자열, 32자 이상 권장). python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_SECRET=
# 카카오 로그인: developers.kakao.com > 내 애플리케이션 > 앱 키 'REST API 키', 카카오 로그인 활성화, 동의항목 '닉네임'
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
# 네이버 로그인: developers.naver.com > 애플리케이션 등록 > 네이버 로그인, 제공 정보 '별명'
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# 관리자 회원 번호 (로그인 후 /login '내 계정' 에 보이는 번호, 쉼표로 여러 명). /data 화면을 볼 수 있다
ADMIN_MEMBER_KEYS=

# 네이버 지도 (선택) — 네이버 클라우드 > Maps > Application 에서 'Dynamic Map' 체크, Web 서비스 URL 에 앱 주소 등록
# 비워 두면 위 NAVER_MAPS_CLIENT_ID 를 같이 쓰고, 그것도 없으면 카카오맵 → 기본 지도 순서
NAVER_MAP_CLIENT_ID=

# 관리자 대시보드 "Claude 예약 작업" 버튼이 열 주소 (claude.ai/code/routines/<예약 작업 번호>). 비우면 예약 작업 목록
ADMIN_ROUTINE_URL=

# 블로그 후기 (네이버클라우드 NAVER API HUB 의 블로그 검색). 비우면 상세 화면에 블로그 후기 칸이 안 생김
NAVER_BLOG_CLIENT_ID=
NAVER_BLOG_CLIENT_SECRET=
# 호출 주소 (비우면 https://naverapihub.apigw.ntruss.com/search/v1/blog)
NAVER_BLOG_URL=
# ncp = X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 헤더 (기본), naver = X-Naver-Client-Id / -Secret
NAVER_BLOG_HEADERS=ncp

# 공개 웹(Vercel) 캐시 바로 비우기 (선택). Vercel 환경변수 WEB_REVALIDATE_SECRET 과 같은 값을 넣으면,
# Notion 에서 새 팝업을 가져온 직후 웹에도 바로 보인다 (비우면 웹은 10분 뒤 스스로 갱신). common/web_refresh.py
WEB_REVALIDATE_SECRET=
# 부를 주소 (비우면 https://ani-where.vercel.app/api/revalidate)
WEB_REVALIDATE_URL=
