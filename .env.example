# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Sheets (둘 중 하나만 채우면 됩니다)
# 1) 서비스 계정 JSON 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# 2) 시트 문서 키 (URL 의 /d/ 와 /edit 사이 문자열)
GSHEET_KEY=

# 카카오 (선택, 권장) — https://developers.kakao.com > 내 애플리케이션 > 앱 키
# REST API 키: 주소·가게 이름 검색과 좌표 변환
KAKAO_REST_API_KEY=
# JavaScript 키: 메인 지도. 플랫폼 > Web 에 http://localhost:8501 을 등록해야 지도가 뜹니다
KAKAO_JS_KEY=
# (우편번호 찾기는 키 없이 동작합니다)

# 네이버 주소 검색 (선택, 카카오 키가 없을 때만 씁니다. 둘 중 하나만 있어도 됩니다)
# 1) 네이버 클라우드 플랫폼 > Maps > Application 등록 후 Client ID / Secret (Geocoding 사용 체크)
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# 옛 콘솔에서 받은 키라면 https://naveropenapi.apigw.ntruss.com 로 바꿔 주세요
NAVER_MAPS_API_HOST=https://naveropenapi.apigw.gov-ntruss.com
# 2) 네이버 개발자센터 > 애플리케이션 등록 > 검색 API (가게 이름으로 찾기)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 저장소 모드: sheets | local  (local 이면 data/ 폴더의 JSON 파일을 씁니다)
STORAGE_MODE=local

# 프롬프트 버전 (앱별로 고정. 비워 두면 가장 높은 버전 파일을 씁니다)
PRIORITY_PROMPT_VERSION=v1
CAFE_PROMPT_VERSION=v2

# Notion 트래커 DB 자동 가져오기 (선택)
# https://www.notion.so/my-integrations 에서 '내부 통합' 을 만들고 키를 넣은 뒤,
# Notion 의 '🎀 애니 팝업·콜라보 트래커' DB 오른쪽 위 ··· > 연결 > 그 통합을 추가하세요
NOTION_TOKEN=
NOTION_DATABASE_ID=3da1fd80371141c697fabf7b742e0edc
